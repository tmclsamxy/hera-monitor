# 复制为 .env 后按需修改，docker compose 会自动读取
#
# 也可以完全不用本文件，改用安装脚本一步到位：
#   bash install.sh --port 9000 --host 0.0.0.0

# 面板对外端口（改完执行 docker compose up -d 生效）
HERA_PORT=8080

# 宿主机绑定地址：
#   0.0.0.0   = 公网可访问（默认）
#   127.0.0.1 = 只允许本机访问（适合前面挂 Nginx / Caddy 反代）
HERA_BIND=0.0.0.0

# 面板公网地址。填了之后，面板里「接入新服务器」生成的一键命令会用它，
# 走域名 + HTTPS 反代时必填，例如 https://monitor.example.com
# HERA_PUBLIC_URL=https://monitor.example.com

# 时区
TZ=Asia/Shanghai
